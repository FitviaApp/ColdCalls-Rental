[Unit]
Description=ColdCalls FastAPI application
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/ColdCalls-Rental
EnvironmentFile=/var/www/ColdCalls-Rental/.env
ExecStart=/bin/bash /var/www/ColdCalls-Rental/deploy/bin/start-app.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
