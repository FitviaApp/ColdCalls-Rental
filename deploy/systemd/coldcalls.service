[Unit]
Description=ColdCalls FastAPI application
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/ColdCalls-Rental
EnvironmentFile=/var/www/ColdCalls-Rental/.env
ExecStart=/var/www/ColdCalls-Rental/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
