[Unit]
Description=ColdCalls background worker
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/ColdCalls-Rental
EnvironmentFile=/var/www/ColdCalls-Rental/.env
ExecStart=/var/www/ColdCalls-Rental/venv/bin/python worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
